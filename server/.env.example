# Set these in Vercel Project Settings > Environment Variables for deployments.
# For local development, copy this file to server/.env and fill in your values.
# Never prefix server secrets with VITE_.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/nutrition_value?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
# Connect a PUBLIC Vercel Blob store and copy its read/write token here locally.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_YOUR_STORE_YOUR_TOKEN
# Public Blob store origin, for example https://STORE.public.blob.vercel-storage.com
BLOB_PUBLIC_ORIGIN=https://STORE.public.blob.vercel-storage.com
ADMIN_EMAIL=admin@localhost
# Local development only. Vercel always uses MONGO_URI.
USE_LOCAL_MONGO=false
PORT=5000
